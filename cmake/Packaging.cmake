# Relocatable staging tree, usable as the content root for a Steam depot.
option(SOLAR_PACKAGE_TERRAIN "Include the three prepared high-resolution terrain datasets" OFF)
set(SOLAR_TERRAIN_DIR "${PROJECT_SOURCE_DIR}/data" CACHE PATH "Prepared terrain data for packaging")
option(SOLAR_BUNDLE_SDL "Install the linked SDL shared library with the app" ON)
install(TARGETS solar_system_sim RUNTIME DESTINATION .)
install(DIRECTORY "${PROJECT_SOURCE_DIR}/assets" DESTINATION .)
install(DIRECTORY "${PROJECT_SOURCE_DIR}/docs/" DESTINATION docs
        FILES_MATCHING PATTERN "*.md" PATTERN "*.png")
install(FILES "${PROJECT_SOURCE_DIR}/README.md" "${PROJECT_SOURCE_DIR}/release/THIRD_PARTY_NOTICES.md" DESTINATION .)
install(DIRECTORY "${PROJECT_SOURCE_DIR}/release/licenses" DESTINATION .)
if(SOLAR_PACKAGE_TERRAIN)
  foreach(dataset mars16.mola mercury64.dem moon64.dem)
    if(NOT EXISTS "${SOLAR_TERRAIN_DIR}/${dataset}")
      message(FATAL_ERROR "Release terrain is missing: ${SOLAR_TERRAIN_DIR}/${dataset}")
    endif()
    install(FILES "${SOLAR_TERRAIN_DIR}/${dataset}" DESTINATION data)
  endforeach()
endif()
if(SOLAR_BUNDLE_SDL AND TARGET SDL3::SDL3-shared)
  if(WIN32)
    install(FILES "$<TARGET_FILE:SDL3::SDL3-shared>" DESTINATION .)
  elseif(UNIX AND NOT APPLE)
    # Install a real file with the SONAME used by the executable (no dangling link).
    install(FILES "$<TARGET_FILE:SDL3::SDL3-shared>" DESTINATION lib
            RENAME "$<TARGET_SONAME_FILE_NAME:SDL3::SDL3-shared>")
    set_property(TARGET solar_system_sim PROPERTY INSTALL_RPATH "$ORIGIN/lib")
  endif()
endif()
set(CPACK_PACKAGE_NAME "SolarSystemSim")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_GENERATOR "ZIP")
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY ON)
include(CPack)
